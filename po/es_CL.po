#. TRANSLATORS: %s is the module the file is being played on, e.g. "SC-8820".
#: src/app/ts-transport.cpp:99
#, c-format
msgid "Sound Canvas voice · %s"
msgstr "Voz Sound Canvas · %s"

#. TRANSLATORS: sounding voices over the polyphony ceiling, e.g. "12/64 voices". Deliberately
#. one form rather than a plural: the noun agrees with the ceiling, not with the first number,
#. so "1/64 voice" would be wrong.
#: src/app/ts-transport.cpp:128 src/app/ts-transport.cpp:451
#, c-format
msgid "%d/%d voices"
msgstr "%d/%d voces"

#: src/app/ts-transport.cpp:150
#, c-format
msgid "%ld dropout"
msgid_plural "%ld dropouts"
msgstr[0] "%ld corte"
msgstr[1] "%ld cortes"

#. TRANSLATORS: a percentage of the engine's own output level. Some locales put a space
#. before the sign.
#: src/app/ts-transport.cpp:208 src/app/ts-transport.cpp:405
#, c-format
msgid "%d%%"
msgstr "%d%%"

#: src/app/ts-transport.cpp:229
msgid "Pause"
msgstr "Pausar"

#: src/app/ts-transport.cpp:229
msgid "Play"
msgstr "Reproducir"

#: src/app/ts-transport.cpp:297
msgid ""
"Seek. Jumping replays the controllers up to that point, so the parts sound "
"as they would have."
msgstr ""
"Buscar. Saltar vuelve a reproducir los controladores hasta ese punto, de "
"modo que las partes suenan como habrían sonado."

#: src/app/ts-transport.cpp:330
msgid "Go back to the start"
msgstr "Volver al inicio"

#: src/app/ts-transport.cpp:338
msgid ""
"Repeat at the file's own loop points, or over the whole file if it declares "
"none"
msgstr ""
"Repetir en los puntos de bucle del propio archivo, o sobre el archivo "
"completo si no declara ninguno"

#: src/app/ts-transport.cpp:344
msgid "Panic: silence every voice and return each part to its power-on state"
msgstr ""
"Pánico: silenciar todas las voces y devolver cada parte a su estado de "
"encendido"

#: src/app/ts-transport.cpp:361
msgid ""
"Gain on the finished mix. 100% is the engine's own level; above it a loud "
"file can clip."
msgstr ""
"Ganancia sobre la mezcla final. 100 % es el nivel propio del motor; por "
"encima, un archivo fuerte puede saturar."

#: src/app/ts-transport.cpp:426
msgid "Exporting…"
msgstr "Exportando…"

#: src/app/ts-transport.cpp:462
msgid "The file put the engine into XG mode"
msgstr "El archivo puso el motor en modo XG"

#: src/app/ts-transport.cpp:474
msgid ""
"The engine could not keep the buffer fed. Raise the buffer in Preferences."
msgstr ""
"El motor no pudo mantener el búfer alimentado. Sube el búfer en Preferencias."

#: src/app/ts-voice-meter.cpp:138
#, c-format
msgid "%d voice sounding"
msgid_plural "%d voices sounding"
msgstr[0] "%d voz sonando"
msgstr[1] "%d voces sonando"

